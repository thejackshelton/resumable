{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core",
    "strict": true,
    "plugins": [
      {
        "name": "@resumable.dev/typescript-plugin",
        "pagesDir": "./pages"
      }
    ],
    "types": ["vite/client"]
  },
  "include": ["resumable-env.d.ts", "pages", "document.tsx", "vite.config.ts"]
}
